default_platform(:ios)

# Auth: deliver picks up the App Store Connect API key automatically from
#   APP_STORE_CONNECT_API_KEY_KEY_ID / _ISSUER_ID / _KEY
# (export them first — e.g. `source ~/.appstoreconnect/env.sh`). No 2FA,
# no session expiry. Falls back to interactive Apple ID if none are set.

platform :ios do
  desc "Capture App Store screenshots (runs the XCUITest pipeline for both device classes)"
  desc "Needs a signed-in session or SKY_TEST_HANDLE/SKY_TEST_APP_PASSWORD — see scripts/capture_screenshots.sh"
  lane :screenshots do
    sh "cd .. && xcodegen generate --spec project.yml"
    sh "cd .. && ./scripts/capture_screenshots.sh 'iPhone 17 Pro Max' iphone-6.9"
    sh "cd .. && ./scripts/capture_screenshots.sh 'iPad Pro 13-inch (M5)' ipad-13"
  end

  desc "Upload screenshots from ../screenshots-appstore/ to App Store Connect"
  lane :upload_screenshots do
    # Stage capture-script output into deliver's per-locale layout. Device
    # class is inferred from pixel dimensions; the filename prefix only
    # keeps the two sets sorted together.
    staging = File.expand_path("screenshots/en-US", __dir__)
    FileUtils.rm_rf(staging)
    FileUtils.mkdir_p(staging)
    staged = {}
    {
      "iphone-6.9" => "iphone69",
      "ipad-13"    => "ipad13",
    }.each do |src, prefix|
      # [0-9][0-9]- matches 10- and above; the old 0[1-9]- glob silently
      # dropped any tenth screenshot from the upload.
      files = Dir[File.expand_path("../screenshots-appstore/#{src}/[0-9][0-9]-*.png", __dir__)]
      files.each { |f| FileUtils.cp(f, File.join(staging, "#{prefix}-#{File.basename(f)}")) }
      staged[prefix] = files
    end
    # overwrite_screenshots wipes EVERY device class in the locale, not just
    # the ones staged — uploading an iPhone-only set deletes the iPad set
    # that lives only in ASC (this happened 2026-06-10). Refuse partial
    # uploads unless explicitly forced. "Partial" means any of: a missing
    # class, unequal shot counts between classes (one capture run failed
    # midway), or one class's captures much older than the other's (stale
    # leftovers from a previous run would overwrite current ASC state).
    unless ENV["SKY_ALLOW_PARTIAL"] == "1"
      staged.each do |prefix, files|
        UI.user_error!("No #{prefix} screenshots staged — a partial upload would delete the other device class in ASC. Capture both sets, or set SKY_ALLOW_PARTIAL=1 to override.") if files.empty?
      end
      counts = staged.transform_values(&:length)
      if counts.values.uniq.length > 1
        UI.user_error!("Unequal screenshot counts #{counts} — one capture run looks incomplete. Re-capture, or set SKY_ALLOW_PARTIAL=1 to override.")
      end
      if (expected = ENV["SKY_EXPECTED_SHOTS"]&.to_i) && counts.values.any? { |c| c != expected }
        UI.user_error!("Expected #{expected} screenshots per device class, staged #{counts}.")
      end
      newest = staged.transform_values { |files| files.map { |f| File.mtime(f) }.max }
      if (newest.values.max - newest.values.min) > 24 * 3600
        UI.user_error!("Screenshot sets were captured more than 24h apart (#{newest}) — one looks stale. Re-capture both, or set SKY_ALLOW_PARTIAL=1 to override.")
      end
    end
    deliver(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      screenshots_path: File.expand_path("screenshots", __dir__),
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload App Store listing metadata only (no binary, no screenshots)"
  desc "Copy source of truth: app-store/PUBLIC_RELEASE_COPY.md"
  lane :upload_listing do
    deliver(
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true, # metadata is reviewed in git, not the HTML preview
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false
    )
  end
end
