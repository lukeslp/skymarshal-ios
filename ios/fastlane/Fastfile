require "shellwords"

default_platform(:ios)

API_KEY_JSON = File.expand_path("~/.appstoreconnect/api_key.json")

def asc_key
  require "json"
  cfg = JSON.parse(File.read(API_KEY_JSON))
  app_store_connect_api_key(
    key_id: cfg["key_id"],
    issuer_id: cfg["issuer_id"],
    key_filepath: File.expand_path(cfg["key_filepath"]),
    in_house: false
  )
end

platform :ios do
  desc "Archive a signed Release build and upload it to TestFlight"
  desc "Bump CFBundleVersion in project.yml first — ASC rejects a reused build number."
  desc "Needs APP_STORE_CONNECT_API_KEY_* in the env (source ~/.appstoreconnect/env.sh) — pilot auto-detects them."
  lane :release_testflight do
    # Xcode's system rsync launches a second rsync process while packaging.
    # Keep Apple's binary ahead of Homebrew's incompatible receiver while
    # retaining the rest of PATH for xcodegen, xcbeautify, and fastlane.
    system_paths = %w[/usr/bin /bin /usr/sbin /sbin]
    ENV["PATH"] = (system_paths + ENV.fetch("PATH", "").split(":"))
      .reject(&:empty?)
      .uniq
      .join(":")

    # The binary upload runs through altool/Transporter, which — unlike the
    # Spaceship-based deliver lanes — does NOT read APP_STORE_CONNECT_API_KEY_*
    # from the env on its own. Build an explicit key from the .p8 and hand it
    # to pilot, or it falls back to demanding an app-specific password.
    #
    # Source the key from api_key.json via `asc_key` rather than from the
    # environment. env.sh and api_key.json drift: on 2026-08-04 env.sh still
    # exported a rotated-out key id whose .p8 had been deleted, so this lane
    # died before it built anything while every other lane worked. One file
    # is the source of truth.
    api_key = asc_key
    sh "cd .. && xcodegen generate --spec project.yml"
    build_app(
      project: "Skymarshal.xcodeproj",
      scheme: "Skymarshal",
      configuration: "Release",
      output_directory: "build/ipa",
      output_name: "Skymarshal.ipa",
      clean: true,
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Wait for the uploaded build to finish processing, then set its What to Test notes"
  desc "Run after release_testflight. Binary is already up; this only attaches metadata."
  desc "Override the text with SKY_WHATS_TO_TEST."
  lane :testflight_notes do
    # Read as UTF-8 explicitly. Without an encoding argument Ruby uses the
    # shell's locale, and under a non-UTF-8 LANG any curly quote or em dash in
    # the notes fails with "invalid byte sequence in US-ASCII" — after the
    # build has already been located, so it looks like an ASC problem.
    # Lives outside metadata/ on purpose: this is TestFlight tester copy, not
    # App Store listing metadata, and deliver scans metadata/ by filename.
    notes = ENV["SKY_WHATS_TO_TEST"] ||
            File.read("what_to_test.txt", encoding: "UTF-8")
    # `distribute_only` (not `skip_binary_upload` — that option does not exist
    # in this fastlane) attaches metadata to a build already in ASC. Version and
    # build come from project.yml so the lane targets the build just uploaded
    # rather than whatever happens to be newest.
    require "yaml"
    spec = YAML.load_file(File.expand_path("../project.yml", __dir__))
    settings = spec.fetch("settings").fetch("base")
    upload_to_testflight(
      api_key: asc_key,
      distribute_only: true,
      # Required in distribute-only mode — without it pilot prompts for the
      # platform and dies in any non-interactive shell (CI, background run).
      app_platform: "ios",
      app_identifier: "blue.skymarshal.ios",
      app_version: settings.fetch("MARKETING_VERSION").to_s,
      build_number: settings.fetch("CURRENT_PROJECT_VERSION").to_s,
      distribute_external: false,
      notify_external_testers: false,
      changelog: notes
    )
  end

  desc "Read-only: print the current ASC version state and recent build states"
  lane :asc_state do
    require "spaceship"
    token = Spaceship::ConnectAPI::Token.create(
      key_id: JSON.parse(File.read(API_KEY_JSON))["key_id"],
      issuer_id: JSON.parse(File.read(API_KEY_JSON))["issuer_id"],
      filepath: File.expand_path(JSON.parse(File.read(API_KEY_JSON))["key_filepath"])
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find("blue.skymarshal.ios")
    UI.important("App: #{app.name} (#{app.id})")
    edit = app.get_edit_app_store_version
    if edit
      UI.important("EDIT version #{edit.version_string} state=#{edit.app_store_state}")
      b = edit.build
      UI.important("  attached build: #{b ? b.version : "(none)"}")
    else
      UI.important("EDIT version: none")
    end
    live = app.get_live_app_store_version
    UI.important("LIVE version #{live&.version_string} state=#{live&.app_store_state}")
    Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 5).each do |bld|
      UI.important("BUILD #{bld.version} processing=#{bld.processing_state} expired=#{bld.expired} compliance=#{bld.uses_non_exempt_encryption.inspect}")
    end
  end

  desc "Submit the current project.yml version to App Store review"
  desc "Sets the ASC version string, attaches the matching build, submits. Manual release after approval."
  desc "ASC blocks renaming a version that is already in review — check state first if this errors."
  lane :submit_for_review do
    require "yaml"
    spec = YAML.load_file(File.expand_path("../project.yml", __dir__))
    settings = spec.fetch("settings").fetch("base")
    version = settings.fetch("MARKETING_VERSION").to_s
    build = settings.fetch("CURRENT_PROJECT_VERSION").to_s
    UI.important("Submitting #{version} (#{build}) for App Store review")
    deliver(
      api_key: asc_key,
      app_version: version,
      build_number: build,
      # The ASC version record lagged the binary on 2026-08-05: a 1.0.4 version
      # was open while the build said 1.1.0, and a build cannot attach to a
      # version whose string differs. Leaving this false lets deliver align the
      # version record with project.yml.
      skip_app_version_update: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "./fastlane/metadata",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Capture App Store screenshots (runs the XCUITest pipeline for both device classes)"
  desc "Needs a signed-in session or SKY_TEST_HANDLE/SKY_TEST_APP_PASSWORD — see scripts/capture_screenshots.sh"
  lane :screenshots do
    sh "cd .. && xcodegen generate --spec project.yml"
    sh "cd .. && ./scripts/capture_screenshots.sh 'iPhone 17 Pro Max' iphone-6.9"
    sh "cd .. && ./scripts/capture_screenshots.sh 'iPad Pro 13-inch (M5)' ipad-13"
  end

  desc "Upload finished marketing screenshots from ../screenshots-marketing/ to App Store Connect"
  lane :upload_screenshots do
    # Stage capture-script output into deliver's per-locale layout. Device
    # class is inferred from pixel dimensions; the filename prefix only
    # keeps the two sets sorted together.
    staging = File.expand_path("screenshots/en-US", __dir__)
    FileUtils.rm_rf(staging)
    FileUtils.mkdir_p(staging)
    staged = {}
    {
      "iphone-6.9" => "iphone69",
      "ipad-13"    => "ipad13",
    }.each do |src, prefix|
      # [0-9][0-9]- matches 10- and above; the old 0[1-9]- glob silently
      # dropped any tenth screenshot from the upload.
      files = Dir[File.expand_path("../screenshots-marketing/#{src}/[0-9][0-9]-*.png", __dir__)].sort
      files.each do |f|
        destination = File.join(staging, "#{prefix}-#{File.basename(f)}")
        # XCTAttachment output is usually opaque, but iPad captures can
        # occasionally retain an alpha channel. App Store Connect requires
        # flat screenshots, so composite those onto white while staging.
        has_alpha = `sips -g hasAlpha #{Shellwords.escape(f)} 2>/dev/null`.include?("hasAlpha: yes")
        if has_alpha
          UI.user_error!("ImageMagick is required to flatten #{File.basename(f)}. Install it with `brew install imagemagick`.") unless system("command -v magick >/dev/null 2>&1")
          sh "magick #{Shellwords.escape(f)} -background white -alpha remove -alpha off #{Shellwords.escape(destination)}"
        else
          FileUtils.cp(f, destination)
        end
      end
      staged[prefix] = files
    end
    # overwrite_screenshots wipes EVERY device class in the locale, not just
    # the ones staged — uploading an iPhone-only set deletes the iPad set
    # that lives only in ASC (this happened 2026-06-10). Refuse partial
    # uploads unless explicitly forced. "Partial" means any of: a missing
    # class, unequal shot counts between classes (one capture run failed
    # midway), or one class's captures much older than the other's (stale
    # leftovers from a previous run would overwrite current ASC state).
    unless ENV["SKY_ALLOW_PARTIAL"] == "1"
      staged.each do |prefix, files|
        UI.user_error!("No #{prefix} screenshots staged — a partial upload would delete the other device class in ASC. Capture both sets, or set SKY_ALLOW_PARTIAL=1 to override.") if files.empty?
      end
      counts = staged.transform_values(&:length)
      if counts.values.uniq.length > 1
        UI.user_error!("Unequal screenshot counts #{counts} — one capture run looks incomplete. Re-capture, or set SKY_ALLOW_PARTIAL=1 to override.")
      end
      if (expected = ENV["SKY_EXPECTED_SHOTS"]&.to_i) && counts.values.any? { |c| c != expected }
        UI.user_error!("Expected #{expected} screenshots per device class, staged #{counts}.")
      end
      newest = staged.transform_values { |files| files.map { |f| File.mtime(f) }.max }
      if (newest.values.max - newest.values.min) > 24 * 3600
        UI.user_error!("Screenshot sets were captured more than 24h apart (#{newest}) — one looks stale. Re-capture both, or set SKY_ALLOW_PARTIAL=1 to override.")
      end
    end
    deliver(
      api_key: asc_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      screenshots_path: File.expand_path("screenshots", __dir__),
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload App Store listing metadata only (no binary, no screenshots)"
  desc "Copy source of truth: app-store/PUBLIC_RELEASE_COPY.md"
  lane :upload_listing do
    deliver(
      api_key: asc_key,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true, # metadata is reviewed in git, not the HTML preview
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false
    )
  end
end
